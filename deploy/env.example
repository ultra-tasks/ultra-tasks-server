# Copy to deploy/.env; never commit the populated file.
# Use a tested immutable tag or digest from this repository's container package.
SERVER_IMAGE=ghcr.io/ultra-tasks/ultra-tasks-server:REPLACE_WITH_TESTED_TAG
DOMAIN=app.example.com
PUBLIC_URL=https://app.example.com
# Leave empty: the web app and dashboard share this origin, so no CORS is needed.
# List an origin only to let a separately hosted web app call this server.
CORS_ORIGINS=
# Where scripts/install-web.sh puts released web bundles (served at the origin root).
ULTRA_WEB_DIRECTORY=./web
POSTGRES_PASSWORD=
ULTRA_SERVER_ID=
ULTRA_OPAQUE_SETUP=
ULTRA_AUTH_SECRET=
# OPAQUE still authenticates passwords; Better Auth owns access sessions.
ULTRA_AUTH_ENGINE=better-auth
# For an existing host HTTPS proxy, enable the loopback-only Compose overlay.
ULTRA_EXTERNAL_PROXY=false
ULTRA_HTTP_PORT=1900
ULTRA_REGISTRATION_OPEN=false
# Opt-in readable calendar copies; update your privacy notice before enabling.
ULTRA_CALENDAR_FEEDS_ENABLED=false
ULTRA_REQUIRE_TERMS_CONSENT=true
# New-device email verification: a sign-in from an unrecognised device must also enter a code
# that is emailed to the account (needs working SMTP below). Enrolled authenticator or security
# key factors always take precedence. true (default): on. false: operator kill switch, with no
# challenges and no new trusted devices. Apps without support for the code step are told to
# update; read docs/account-devices-and-sessions.md (Rollout) before leaving it on while
# beta 1 apps are still installed.
ULTRA_DEVICE_EMAIL_VERIFICATION=true
# Session lifetime. A session in use stays signed in: the idle window (days) slides on every
# refresh and the absolute cap (days, 0 = none) is fixed when the session is issued. A cap
# shorter than the idle window is refused at startup.
ULTRA_SESSION_IDLE_DAYS=180
ULTRA_SESSION_MAX_DAYS=1095
# Optional: publish the privacy policy at an HTTPS address you already maintain.
# /privacy.html (the link beside the sign-up consent box) then redirects there,
# and no deploy/legal/privacy.html is needed. Leave empty to serve your own file.
ULTRA_PRIVACY_URL=

# Optional: set both values to protect account registration with Cloudflare Turnstile.
ULTRA_TURNSTILE_SITE_KEY=
ULTRA_TURNSTILE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
