# Copy to deploy/.env; never commit the populated file.
# Use a tested immutable tag or digest from this repository's container package.
SERVER_IMAGE=ghcr.io/ultra-tasks/ultra-tasks-server:REPLACE_WITH_TESTED_TAG
DOMAIN=app.example.com
PUBLIC_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
POSTGRES_PASSWORD=
ULTRA_SERVER_ID=
ULTRA_OPAQUE_SETUP=
ULTRA_AUTH_SECRET=
# OPAQUE still authenticates passwords; Better Auth owns access sessions.
ULTRA_AUTH_ENGINE=better-auth
# For an existing host HTTPS proxy, enable the loopback-only Compose overlay.
ULTRA_EXTERNAL_PROXY=false
ULTRA_HTTP_PORT=1900
ULTRA_REGISTRATION_OPEN=false
ULTRA_REQUIRE_TERMS_CONSENT=true
# Optional: set both values to protect account registration with Cloudflare Turnstile.
ULTRA_TURNSTILE_SITE_KEY=
ULTRA_TURNSTILE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
