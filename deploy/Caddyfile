{$DOMAIN} {
    header {
        Referrer-Policy no-referrer
        X-Content-Type-Options nosniff
        -Server
    }
    # Account recovery and login URLs contain one-use credentials. Do not log them.

    # Paths the account server owns. Everything else on this origin is the web
    # task application when a bundle is installed (scripts/install-web.sh).
    @server path /account /account/* /api/* /live /health /privacy.html /terms.html
    handle @server {
        reverse_proxy server:1900
    }

    # Without an installed bundle the server keeps answering "/" (it redirects to
    # /account), exactly as before the web app existed.
    @nobundle {
        not {
            file {
                root /srv/web/current
                try_files /index.html
            }
        }
    }
    handle @nobundle {
        reverse_proxy server:1900
    }

    handle {
        root * /srv/web/current

        # OAuth providers redirect to /oauth/callback/<provider>; one static page
        # handles every provider.
        rewrite /oauth/callback/* /oauth-callback.html

        # Files the service worker uses to detect a new release must always be
        # revalidated. Hashed build output never changes under the same name.
        @revalidate path / /index.html /sw.js /ngsw-worker.js /ngsw.json /manifest.json /oauth-callback.html
        header @revalidate Cache-Control "no-cache"
        @hashed path /main-* /chunk-* /polyfills-* /styles-* /worker-* /media/*
        header @hashed Cache-Control "public, max-age=31536000, immutable"

        # The web application is a different trust zone from the dashboard, so it
        # carries its own policy instead of the server's. Report-only until it has
        # been checked against the real bundle.
        header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"

        file_server
    }
}
