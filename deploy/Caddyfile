{$DOMAIN} {
    header {
        Referrer-Policy no-referrer
        X-Content-Type-Options nosniff
        -Server
    }
    # Account recovery and login URLs contain one-use credentials. Do not log them.

    # Paths the account server owns. Everything else on this origin is the web
    # task application when a bundle is installed (scripts/install-web.sh).
    # The dashboard page also loads its CSS, scripts and logo from root paths that
    # @fastify/static serves out of account-public/ (private-server.ts), so those
    # belong to the server too. /cal/* is the public calendar feed.
    @server path /account /account/* /api/* /live /health /privacy.html /terms.html /cal/* /ultra-account.html /ultra-account.css /account-theme.css /account-assets/* /simplewebauthn-browser.min.js /ultra-account/*
    handle @server {
        reverse_proxy server:1900
    }

    # Without an installed bundle the server keeps answering "/" (it redirects to
    # /account), exactly as before the web app existed.
    @nobundle {
        not {
            file {
                root /srv/web/current
                try_files /index.html
            }
        }
    }
    handle @nobundle {
        reverse_proxy server:1900
    }

    handle {
        root * /srv/web/current

        # OAuth providers redirect to /oauth/callback/<provider>; one static page
        # handles every provider. The page ships in the bundle under assets/.
        rewrite /oauth/callback/* /assets/oauth-callback.html

        # Files the service worker uses to detect a new release must always be
        # revalidated. That includes the un-hashed worker scripts (safety-worker.js and
        # worker-basic.min.js), which keep the same name in every release.
        @revalidate path / /index.html /sw.js /ngsw-worker.js /safety-worker.js /worker-basic.min.js /ngsw.json /manifest.json /assets/oauth-callback.html
        header @revalidate Cache-Control "no-cache"
        # Only files whose name carries an 8-character content hash are immutable. A
        # looser /worker-* match would also catch worker-basic.min.js.
        @hashed path_regexp ^/((main|chunk|polyfills|styles|worker)-[A-Za-z0-9_-]{8}\.(js|css)|media/.+)$
        header @hashed Cache-Control "public, max-age=31536000, immutable"

        # The web application is a different trust zone from the dashboard, so it
        # carries its own policy instead of the server's. Report-only until it has
        # been checked against the real bundle.
        header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"

        file_server
    }
}
