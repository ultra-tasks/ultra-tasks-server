{
  "name": "ultra-tasks-server-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ultra-tasks/ultra-tasks-server.git"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "quiet": "node tools/quiet.js",
    "build:packages": "npm run build -w @ultra-tasks/sync-contract && npm run build -w @ultra-tasks/account-crypto",
    "build:dashboard": "npm run build -w @ultra-tasks/account-dashboard",
    "build": "npm run build:packages && npm run build:dashboard && npm run build -w @ultra-tasks/server",
    "db:generate": "npm exec -w @ultra-tasks/server -- prisma generate",
    "test:crypto": "npm test -w @ultra-tasks/account-crypto",
    "test:native": "npm run test:native -w @ultra-tasks/server",
    "test:server": "npm test -w @ultra-tasks/server",
    "test:accounts:browser": "npm run test:ultra-accounts:browser -w @ultra-tasks/server",
    "test:client:browser": "npm run test:ultra-sync:browser -w @ultra-tasks/server",
    "test:postgres": "npm run test:integration:postgres -w @ultra-tasks/server",
    "test": "npm run test:crypto && npm run test:native",
    "start": "npm start -w @ultra-tasks/server",
    "prettier:file": "prettier --write",
    "checkFile": "prettier --check",
    "typecheck": "npm run typecheck -w @ultra-tasks/account-dashboard",
    "test:private:browser": "npm exec -w @ultra-tasks/server -- vitest run --config vitest.private-browser.config.ts",
    "test:realtime:load": "npm exec -w @ultra-tasks/server -- vitest run --config vitest.native-load.config.ts",
    "test:parity": "npm exec -w @ultra-tasks/server -- vitest run --config vitest.parity.config.ts"
  }
}
