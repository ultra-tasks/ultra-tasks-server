{
  "name": "@ultra-tasks/server",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Self-hostable Ultra Tasks account and encrypted sync server",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:integration:postgres": "vitest run --config vitest.integration.config.ts --maxWorkers=1 tests/integration/registration-races.integration.spec.ts tests/integration/clean-slate-atomicity-sql.integration.spec.ts tests/integration/device-touch-upload-race.integration.spec.ts tests/integration/conflict-detection-sql.integration.spec.ts tests/integration/batch-conflict-plan.integration.spec.ts tests/integration/snapshot-vector-clock-sql.integration.spec.ts tests/integration/repair-causality.integration.spec.ts tests/integration/health-alert-db-probe.integration.spec.ts tests/integration/migrate-deploy-db-timeout.integration.spec.ts tests/integration/migrate-deploy-lock-retry.integration.spec.ts tests/integration/migrate-deploy-orphan-cleanup.integration.spec.ts tests/integration/old-ops-sweep.integration.spec.ts tests/integration/old-ops-probe-plan.integration.spec.ts tests/integration/download-full-state-plan.integration.spec.ts tests/integration/old-ops-boundary-plan.integration.spec.ts tests/integration/old-ops-delete-plan.integration.spec.ts tests/integration/operations-autovacuum-reloptions.integration.spec.ts tests/integration/state-replacement-guard.integration.spec.ts tests/integration/capture-claim-race.integration.spec.ts",
    "docker:build": "./scripts/build-and-push.sh",
    "docker:deploy": "./scripts/deploy.sh",
    "docker:deploy:build": "./scripts/deploy.sh --build",
    "docker:backup": "./scripts/backup.sh",
    "docker:logs": "docker logs supersync-server -f",
    "docker:monitor": "./scripts/docker-monitor.sh",
    "docker:monitor:usage": "./scripts/docker-monitor.sh usage",
    "docker:monitor:all": "./scripts/docker-monitor.sh monitor-all --save",
    "docker:shell": "./scripts/docker-monitor.sh shell",
    "delete-user": "ts-node scripts/delete-user.ts",
    "clear-data": "ts-node scripts/clear-data.ts",
    "recover-user": "ts-node --transpile-only scripts/recover-user.ts",
    "monitor": "node dist/scripts/monitor.js",
    "monitor:dev": "tsx scripts/monitor.ts",
    "analyze-storage": "node dist/scripts/analyze-storage.js",
    "analyze-storage:dev": "tsx scripts/analyze-storage.ts",
    "monitor:all": "node dist/scripts/run-all-monitoring.js",
    "monitor:all:dev": "tsx scripts/run-all-monitoring.ts",
    "monitor:all:quick": "node dist/scripts/run-all-monitoring.js --quick",
    "monitor:all:save": "node dist/scripts/run-all-monitoring.js --save",
    "migrate-payload-bytes": "node dist/scripts/migrate-payload-bytes.js",
    "migrate-payload-bytes:dev": "ts-node scripts/migrate-payload-bytes.ts",
    "dry-run-old-ops-sweep": "node dist/scripts/dry-run-old-ops-sweep.js",
    "dry-run-old-ops-sweep:dev": "tsx scripts/dry-run-old-ops-sweep.ts",
    "test:ultra-accounts": "tsc -p tsconfig.ultra-tests.json && vitest run tests/ultra-accounts.spec.ts",
    "test:regression": "vitest run",
    "test:ultra-accounts:browser": "tsc -p tsconfig.ultra-tests.json && vitest run --config vitest.accounts-browser.config.ts",
    "test:ultra-sync": "tsc -p tsconfig.ultra-tests.json && vitest run tests/ultra-sync.spec.ts",
    "test:ultra-sync:browser": "tsc -p tsconfig.ultra-tests.json && vitest run --config vitest.native-browser.config.ts",
    "test:ultra-realtime": "tsc -p tsconfig.ultra-tests.json && vitest run tests/ultra-realtime.spec.ts",
    "test:ultra-recovery": "tsc -p tsconfig.ultra-tests.json && vitest run tests/ultra-recovery.spec.ts",
    "test:ultra-realtime:load": "vitest run --config vitest.native-load.config.ts",
    "test:native": "tsc -p tsconfig.ultra-tests.json && vitest run tests/ultra-accounts.spec.ts tests/ultra-sync.spec.ts tests/ultra-realtime.spec.ts tests/ultra-recovery.spec.ts tests/private-profile.spec.ts tests/private-server.spec.ts tests/better-auth.spec.ts tests/browser-login.spec.ts",
    "test:better-auth:browser": "tsc -p tsconfig.ultra-tests.json && vitest run --config vitest.better-auth-browser.config.ts",
    "test:better-auth:postgres": "tsc -p tsconfig.ultra-tests.json && vitest run --config vitest.better-auth-postgres.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "5.22.0",
    "@simplewebauthn/server": "^13.3.2",
    "@simplewebauthn/types": "^12.0.0",
    "@sp/shared-schema": "https://github.com/ultra-tasks/ultra-tasks-server/releases/download/legacy-compat-535576e/sp-shared-schema-1.0.0.tgz",
    "@sp/sync-core": "https://github.com/ultra-tasks/ultra-tasks-server/releases/download/legacy-compat-64e72f9/sp-sync-core-1.0.0.tgz",
    "@ultra-tasks/account-crypto": "0.1.4",
    "@ultra-tasks/sync-contract": "0.1.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.18",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.0",
    "prisma": "5.22.0",
    "uuidv7": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^7.0.5",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.3",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0 || ^6.0.0",
    "vite": "7.3.7",
    "vitest": "^5.0.3"
  }
}
